{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["../.agents/ENGAGEMENT.md", "../AGENTS.md"],
  "default_agent": "product-manager",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": "allow",
    "task": {
      "*": "allow"
    }
  },
  "agent": {
    "product-manager": {
      "description": "Product Manager para produto, backlog, discovery, documentação, sprint, changelog e wiki.",
      "mode": "primary",
      "prompt": "{file:../.agents/skills/product-manager/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "tech-lead": {
      "description": "Tech Lead para viabilidade, dados reais, arquitetura, riscos e Histórias Técnicas.",
      "mode": "primary",
      "prompt": "{file:../.agents/skills/tech-lead/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "product-designer": {
      "description": "Product Designer para telas, design system, protótipos e Figma.",
      "mode": "primary",
      "prompt": "{file:../.agents/skills/product-designer/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "mcp": {
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "/bin/zsh",
        "-lc",
        "set -a; source \"$(git rev-parse --show-toplevel)/.env\"; set +a; exec npx -y firecrawl-mcp"
      ],
      "enabled": true
    }
  }
}
