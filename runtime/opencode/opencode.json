{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "../.agents/system/CONSTITUTION.md",
    "../.agents/org/ORG.md",
    "../AGENTS.md"
  ],
  "default_agent": "product-specialist",
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": "allow",
    "task": {
      "*": "allow"
    }
  },
  "agent": {
    "figma-node-reader": {
      "description": "Transcritor de nodes do Figma para HTML — subagente, acionado pela design-screen",
      "mode": "subagent",
      "prompt": "{file:../.agents/runtime/skills/figma-node-reader/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "product-designer": {
      "description": "Ativa a persona Product Designer na thread principal (telas, design system, protótipo, export para o canvas)",
      "mode": "primary",
      "prompt": "{file:../.agents/runtime/skills/product-designer/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "product-specialist": {
      "description": "Ativa a persona Product Specialist na thread principal (produto, backlog, discovery, docs, sprint, métricas, lançamento)",
      "mode": "primary",
      "prompt": "{file:../.agents/runtime/skills/product-specialist/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "tech-lead": {
      "description": "Ativa a persona Tech Lead na thread principal (viabilidade, dados reais, arquitetura, risco e impacto)",
      "mode": "primary",
      "prompt": "{file:../.agents/runtime/skills/tech-lead/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "edit": "allow",
        "skill": {
          "*": "allow"
        }
      }
    }
  }
}
