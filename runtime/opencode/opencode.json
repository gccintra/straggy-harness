{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-skill-creator"],
  "instructions": ["../AGENTS.md"],
  "permission": {
    "skill": {
      "*": "allow"
    },
    "bash": "allow",
    "task": {
      "*": "allow"
    }
  },
  "agent": {
    "product-manager": {
      "description": "Product Manager para produto, backlog, discovery, documentação, sprint, changelog e wiki.",
      "mode": "primary",
      "prompt": "{file:../.agents/skills/product-manager/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "write": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "tech-lead": {
      "description": "Tech Lead para viabilidade, dados reais, arquitetura, riscos e Histórias Técnicas.",
      "mode": "primary",
      "prompt": "{file:../.agents/skills/tech-lead/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "write": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "product-designer": {
      "description": "Product Designer para telas, design system, protótipos e Figma.",
      "mode": "primary",
      "prompt": "{file:../.agents/skills/product-designer/SKILL.md}",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "write": "allow",
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "mcp": {
    "figma": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "oauth": {
        "clientId": "${FIGMA_CLIENT_ID}",
        "clientSecret": "${FIGMA_CLIENT_SECRET}"
      }
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/${FIRECRAWL_API_KEY}/v2/mcp",
      "enabled": true
    }
  }
}
