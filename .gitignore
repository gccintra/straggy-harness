__pycache__/
*.pyc
node_modules/
.DS_Store

# Segredos — o harness ships o .env.example; o .env preenchido é do projeto e nunca entra aqui
.env
.env.*
!.env.example

# Regras de engajamento — cada dev cria/personaliza o próprio, não versionar no harness
AGENTS.md
CLAUDE.md

# Camada da organização — POSSE do cliente, nunca do harness. O harness ships o scaffold
# em system/pack/org-scaffold/; o install.sh semeia org/ a partir dele. Cada organização
# versiona a própria camada onde quiser (repo próprio, backup) — aqui, nunca.
#
# DESLIGADO por ora: org/ segue versionada junto para não travar o trabalho nos projetos.
# Religar quando a camada tiver destino próprio — e aí é preciso rodar
# `git rm -r --cached org/` para tirá-la do índice.
# org/

# Visão resolvida dos workflows — gerada por runtime/build.sh (cópia, não symlink)
runtime/skills/

# Catálogo como dado — gerado por runtime/build.sh a partir do frontmatter das skills
runtime/manifest.json

# Adapters de runtime — gerados por runtime/build.sh a partir das personas resolvidas
runtime/claude/agents/
runtime/claude/commands/
runtime/codex/agents/
runtime/opencode/opencode.json
runtime/cursor/rules/

# Ponteiro de descoberta por runtime — symlink de pasta para runtime/skills.
# Sem barra final: pattern com barra só casa diretório real, não symlink.
runtime/claude/skills
runtime/codex/skills
runtime/cursor/skills

# Plantio local do Cursor/Claude quando este repo É o projeto (gerado pelo build /
# criado à mão como symlink pro adapter). Sem barra final: pattern com barra só casa
# diretório real, não symlink — sem isso o symlink aparecia untracked mesmo ignorado.
# No projeto consumidor o install.sh planta em <projeto>/.cursor|.claude.
/.cursor
/.claude
/.codex

# Ponto de descoberta de skills do Codex quando o harness roda na própria raiz (self-
# hosted) em vez de <projeto>/.agents/ — build.sh não cria isso sozinho nesse caso.
/.agents

# Resultados de eval — gerados por runtime/eval.sh (report.html + resultado.json)
runtime/evals/
