# ══════════════════════════════════════════════════════════════════════
#  .env.example — Harness de Agentes de Produto
#  Copiado para .env na raiz do projeto pelo .agents/install.sh.
#  Preencha os valores do seu projeto — nenhuma skill precisa ser editada
#  ao trocar de projeto, tudo que varia está aqui e no project-config.md.
#
#  Tudo é opcional: chave vazia = a skill que depende dela avisa e para.
#  Preencha só o que for usar.
# ══════════════════════════════════════════════════════════════════════

# ── GitLab ─────────────────────────────────────────────────────────────
# Usado por: backlog-issue-creator, backlog-prioritization, backlog-health,
#            backlog-analysis, discovery, gitlab-sprint-ops, gitlab-wiki
#
# GITLAB_HOST:  apenas o hostname, sem protocolo (ex: git.empresa.com.br)
# GITLAB_URI:   URL base completa com protocolo (ex: https://git.empresa.com.br)
# GITLAB_TOKEN: personal access token com scope "api"
#               Crie em: GitLab → Preferences → Access Tokens
# GITLAB_REPO:  caminho OWNER/REPO (ex: meugrupo/meuprojeto)
GITLAB_HOST=
GITLAB_URI=
GITLAB_TOKEN=
GITLAB_REPO=

# ── Google Drive (sync de contexto) ────────────────────────────────────
# Usado por: sync-context.sh (Drive → docs/context_docs/md/)
# Setup completo do service account e do rclone: .agents/SYNC_SETUP.md
#
# GDRIVE_HUS: remote rclone da pasta de HUs, no formato abaixo.
#   O <FOLDER_ID> sai da URL da pasta no Drive:
#   https://drive.google.com/drive/folders/<FOLDER_ID>
#   Formato (a vírgula e os dois-pontos fazem parte):
#     GDRIVE_HUS=gdrive,root_folder_id=<FOLDER_ID>:
#
# GDRIVE_REGRAS_DOC_ID: ID do Google Doc único de Regras de Negócio.
#   Sai da URL do doc: .../document/d/<DOC_ID>/edit
#   Vazio → o sync pula as Regras e sincroniza só as HUs.
#
# A pasta e o doc precisam estar compartilhados (papel Leitor) com o
# service account do rclone — ver project-config.md.
GDRIVE_HUS=
GDRIVE_REGRAS_DOC_ID=

# ── Figma ──────────────────────────────────────────────────────────────
# Usado por: design-setup, design-screen, html-to-figma, figma-node-reader
# Só necessário se for ler nodes do Figma ou exportar telas pra lá.
# O protótipo em prototype/ funciona sem nada disto.
#
# Obtenha em: figma.com → Conta → Settings → OAuth apps
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# fileKey: extraído da URL do arquivo Figma
# URL: https://figma.com/design/<fileKey>/nome-do-arquivo
FIGMA_FILE_KEY=

# Preenchido automaticamente pelo @product-designer no setup.
# Não altere manualmente.
FIGMA_GUIDELINES_NODE_ID=

# ── Firecrawl ──────────────────────────────────────────────────────────
# Usado por: skills de pesquisa web (opcional).
# Obtenha em: firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=

# ── Banco de dados de homologação (opcional) ───────────────────────────
# Usado por: db-query (e pelo @tech-lead, que a carrega)
#
# O harness não usa MCP. Executa o cliente CLI do banco diretamente
# via bash, com o comando definido em DB_CONNECT_CMD.
#
# DB_ENABLED: "true" para ativar. Qualquer outro valor desativa.
#             Quando desativado, os agentes respondem só pela documentação.
#
# DB_CLIENT:  executável CLI instalado no sistema.
#             Opções: sqlcmd | psql | mysql | sqlite3 | isql (ODBC/FreeTDS) | ...
#
# DB_PASSWORD: senha de autenticação (se aplicável ao seu método).
#              Deixe vazio se usar autenticação sem senha no comando.
#
# DB_CONNECT_CMD: comando COMPLETO de conexão. Use $DB_QUERY como
#                 placeholder — o agente substitui pela query SQL.
#
# DB_DSN / DB_USER: variáveis AUXILIARES. Não são lidas diretamente por
#                 nenhuma skill — existem para você referenciá-las dentro
#                 do DB_CONNECT_CMD ("$DB_DSN", "$DB_USER"), que o shell
#                 expande na hora de executar. Use as que o seu comando
#                 precisar; crie outras se fizer sentido.
#
# ── Exemplos por banco e método de autenticação ────────────────────────
#
# SQL Server via ODBC/FreeTDS (isql) — DSN em ~/.odbc.ini, usuário de domínio:
#   DB_CLIENT=isql
#   DB_DSN=MEU_DSN_FreeTDS
#   DB_USER='DOMINIO\seu.usuario'
#   DB_PASSWORD=suasenha
#   DB_CONNECT_CMD='echo "$DB_QUERY" | isql -v "$DB_DSN" "$DB_USER" "$DB_PASSWORD" -b -d"|"'
#
# SQL Server + Windows/NTLM (domínio):
#   DB_CLIENT=sqlcmd
#   DB_PASSWORD=suasenha
#   DB_CONNECT_CMD=sqlcmd -S seu-servidor -U "DOMINIO\seu.usuario" -P "${DB_PASSWORD}" -C -Q "$DB_QUERY"
#
# SQL Server + autenticação SQL (usuário/senha):
#   DB_CLIENT=sqlcmd
#   DB_PASSWORD=suasenha
#   DB_CONNECT_CMD=sqlcmd -S seu-servidor -d seu-banco -U seu-usuario -P "${DB_PASSWORD}" -Q "$DB_QUERY"
#
# PostgreSQL + senha:
#   DB_CLIENT=psql
#   DB_PASSWORD=suasenha
#   DB_CONNECT_CMD=psql "postgresql://seu-usuario:${DB_PASSWORD}@seu-host:5432/seu-banco" -c "$DB_QUERY"
#
# PostgreSQL + .pgpass (sem senha no comando):
#   DB_CLIENT=psql
#   DB_PASSWORD=
#   DB_CONNECT_CMD=psql -h seu-host -U seu-usuario -d seu-banco -c "$DB_QUERY"
#
# MySQL:
#   DB_CLIENT=mysql
#   DB_PASSWORD=suasenha
#   DB_CONNECT_CMD=mysql -h seu-host -u seu-usuario -p"${DB_PASSWORD}" seu-banco -e "$DB_QUERY"
#
# SQLite (arquivo local):
#   DB_CLIENT=sqlite3
#   DB_PASSWORD=
#   DB_CONNECT_CMD=sqlite3 /caminho/para/banco.db "$DB_QUERY"
#
DB_ENABLED=false
DB_CLIENT=
DB_DSN=
DB_USER=
DB_PASSWORD=
DB_CONNECT_CMD=
